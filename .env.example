# 复制为 .env 后填写本机路径；程序不自动加载 .env。
# Bash 中运行：set -a; source .env; set +a
# Mock 链路不需要这些变量。

# Piper 硬件客户端（包含 piper_scripts 的 lerobot-piper-2 checkout）
LEROBOT_PIPER_ROOT=/absolute/path/to/lerobot-piper-2
# 已安装 openpi_client 时无需设置；源码方式填写包的 src 目录。
OPENPI_CLIENT_SRC=/absolute/path/to/openpi/packages/openpi-client/src
ROBO_INT_GUI_CONFIG=/absolute/path/to/smolvla_piper_control_gui/config.json
ROBO_INT_SERVER_LAUNCHER=/absolute/path/to/smolvla_piper_control_gui/start_smolvla_server.sh

# 可选的本地 π0.5 / GPU 功能验证，不随仓库分发。
ROBO_INT_PI05_CHECKPOINT=/absolute/path/to/pi05/checkpoints/150000
ROBO_INT_PI05_REFERENCE_SERVER=/absolute/path/to/smolvla_piper_control_gui/smolvla_policy_server.py
# 只有需要对比 8011 / 8012 上的两台服务时才设为 1。
ROBO_INT_PI05_WIRE_PARITY=0
# 只有准备好 GPU、checkpoint 和兼容 LeRobot 环境时才设为 1。
ROBO_INT_PI05_PARITY=0
